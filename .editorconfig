root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust sources: four spaces, matching rustfmt.
[*.rs]
indent_size = 4

# Data and configuration files: two spaces.
[*.{yml,yaml,json}]
indent_size = 2

# Markdown: two spaces, and trailing whitespace is not kept, so no writer needs
# to preserve hard line breaks that way.
[*.md]
indent_size = 2
trim_trailing_whitespace = true
